{
  "schemaName": "ExceptionCase",
  "collectionName": "ExceptionCases",
  "schemaType": 1,
  "description": "One exception on one parcel. Always has exactly one accountable owner; a transfer keeps the current owner until the receiving side acknowledges.",
  "fields": [
    { "name": "caseNumber", "type": "String", "isUniqueData": true, "description": "e.g. EX-240913-0042" },
    { "name": "parcelId", "type": "String" },
    { "name": "trackingId", "type": "String" },
    { "name": "senderUserId", "type": "String", "description": "Denormalised for sender-scoped reads" },
    { "name": "type", "type": "String", "description": "delayed | damaged | refused | address_missing | disputed" },
    { "name": "status", "type": "String", "description": "open | awaiting_ack | in_progress | resolved | closed" },
    { "name": "priority", "type": "String", "description": "normal | high | critical" },
    { "name": "hubCode", "type": "String", "description": "Hub currently handling the case" },
    { "name": "originHubCode", "type": "String" },
    { "name": "destHubCode", "type": "String" },
    { "name": "routeCode", "type": "String" },
    { "name": "riderId", "type": "String" },
    { "name": "riderName", "type": "String" },
    { "name": "codAmount", "type": "Float" },
    { "name": "openedByUserId", "type": "String" },
    { "name": "openedByName", "type": "String" },
    { "name": "openedAt", "type": "DateTime" },
    { "name": "ownerUserId", "type": "String", "description": "Accountable owner right now. Never empty." },
    { "name": "ownerName", "type": "String" },
    { "name": "ownerTeam", "type": "String", "description": "hub:<code> | care | ops" },
    { "name": "ownerSince", "type": "DateTime" },
    { "name": "pendingOwnerTeam", "type": "String", "description": "Team asked to take over; set while status = awaiting_ack" },
    { "name": "pendingOwnerUserId", "type": "String" },
    { "name": "transferRequestedByName", "type": "String" },
    { "name": "transferRequestedAt", "type": "DateTime" },
    { "name": "transferNote", "type": "String" },
    { "name": "slaDueAt", "type": "DateTime" },
    { "name": "slaBreached", "type": "Boolean" },
    { "name": "slaBreachedAt", "type": "DateTime" },
    { "name": "nextStep", "type": "String", "description": "evening_redelivery | call_customer | return_to_sender | courier_claim | address_verification | manual_review" },
    { "name": "nextStepStatus", "type": "String", "description": "none | recommended | confirmed | manual_review" },
    { "name": "nextStepConfidence", "type": "Float" },
    { "name": "nextStepSource", "type": "String", "description": "heuristic | gemini | human" },
    { "name": "nextStepConfirmedByName", "type": "String" },
    { "name": "nextStepConfirmedAt", "type": "DateTime" },
    { "name": "incidentJson", "type": "String", "description": "Structured incident summary (JSON) produced from rider notes" },
    { "name": "description", "type": "String", "description": "Internal free text at open time" },
    { "name": "resolution", "type": "String" },
    { "name": "resolvedAt", "type": "DateTime" },
    { "name": "closedAt", "type": "DateTime" },
    { "name": "seedTag", "type": "String", "description": "Marks demo-seeded rows so they can be reset" }
  ]
}
