# --- SELISE Blocks (public identifiers, safe to commit) -----------------------
# Values come from `blocks projects get --json` and `blocks auth oidc-clients list --json`.
NEXT_PUBLIC_BLOCKS_API_URL=https://blocksapi.slsblx.com
NEXT_PUBLIC_BLOCKS_X_BLOCKS_KEY=Db2c5b9f0bfc347a9b5ae933742efbbaf
NEXT_PUBLIC_BLOCKS_APP_DOMAIN=https://dblyom-elffd.slsblx.com
NEXT_PUBLIC_BLOCKS_OIDC_URL=https://iam.seliseblocks.com
NEXT_PUBLIC_BLOCKS_OIDC_CLIENT_ID=85d564d5-abed-41a8-8792-a9b3effb8817
NEXT_PUBLIC_BLOCKS_OIDC_SCOPE=openid profile

# --- Local HTTPS dev server -------------------------------------------------------
# Hosted login sets a Secure cookie scoped to the project domain, so the dev
# server must run on that exact host + port (both are baked into the OIDC
# redirect URI). `npm run dev` reads these, generates .cert/ on first run and
# starts `next dev` over HTTPS. Add `127.0.0.1 dblyom-elffd.slsblx.com` to /etc/hosts.
BLOCKS_DEV_HOST=dblyom-elffd.slsblx.com
BLOCKS_DEV_PORT=5173

# --- AI (server-side only, never exposed to the browser) --------------------------
# Optional. Without a key the desk falls back to the built-in Banglish heuristic
# engine. Put the real key in .env.local (git-ignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
